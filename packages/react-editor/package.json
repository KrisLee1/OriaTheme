{
  "name": "@oriatheme/react-editor",
  "version": "0.1.3",
  "license": "Apache-2.0",
  "homepage": "https://theme.oria.org.cn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KrisLee1/OriaTheme.git",
    "directory": "packages/react-editor"
  },
  "bugs": "https://github.com/KrisLee1/OriaTheme/issues",
  "description": "Headless React bridge for the OriaTheme editor session.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@oriatheme/core": "workspace:*",
    "@oriatheme/editor-core": "workspace:*",
    "@oriatheme/runtime-dom": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@oriatheme/core": "workspace:*",
    "@oriatheme/runtime-dom": "workspace:*",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "scripts": {
    "prepack": "node ../../scripts/prepare-package-license.mjs",
    "build": "tsup src/index.tsx --format esm --dts --sourcemap --clean --external react --external react-dom --external @oriatheme/editor-core --external @oriatheme/core --external @oriatheme/runtime-dom",
    "lint": "eslint src test",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
