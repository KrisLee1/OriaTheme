{
  "name": "@oriatheme/presets",
  "version": "0.4.0",
  "license": "Apache-2.0",
  "homepage": "https://theme.oria.org.cn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KrisLee1/OriaTheme.git",
    "directory": "packages/presets"
  },
  "bugs": "https://github.com/KrisLee1/OriaTheme/issues",
  "description": "Curated, ready-to-use OriaTheme preset themes.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@oriatheme/core": "workspace:*"
  },
  "scripts": {
    "prepack": "node ../../scripts/prepare-package-license.mjs",
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean --external @oriatheme/core",
    "lint": "eslint src test",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
