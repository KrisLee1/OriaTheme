{
  "name": "@oriatheme/tailwind",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "homepage": "https://theme.oria.org.cn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KrisLee1/OriaTheme.git",
    "directory": "packages/tailwind"
  },
  "bugs": "https://github.com/KrisLee1/OriaTheme/issues",
  "description": "Static Tailwind CSS v4 bridge for oria-standard@2 runtime variables.",
  "type": "module",
  "sideEffects": [
    "./dist/oria.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./oria.css": "./dist/oria.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node ../../scripts/prepare-package-license.mjs",
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean && node scripts/build-css.mjs",
    "lint": "eslint src test",
    "test": "pnpm build && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
