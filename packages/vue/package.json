{
  "name": "@oriatheme/vue",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "homepage": "https://theme.oria.org.cn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KrisLee1/OriaTheme.git",
    "directory": "packages/vue"
  },
  "bugs": "https://github.com/KrisLee1/OriaTheme/issues",
  "description": "Vue bindings for OriaTheme runtime.",
  "type": "module",
  "sideEffects": false,
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "LICENSE"],
  "publishConfig": { "access": "public" },
  "dependencies": { "@oriatheme/runtime-dom": "workspace:*" },
  "peerDependencies": { "vue": "^3.5.0" },
  "devDependencies": { "@oriatheme/core": "workspace:*", "vue": "^3.5.0" },
  "scripts": {
    "prepack": "node ../../scripts/prepare-package-license.mjs",
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean --external vue --external @oriatheme/runtime-dom",
    "lint": "eslint src test",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
