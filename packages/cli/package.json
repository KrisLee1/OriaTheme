{
  "name": "@oriatheme/cli",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "homepage": "https://theme.oria.org.cn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KrisLee1/OriaTheme.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/KrisLee1/OriaTheme/issues",
  "description": "Install verified, user-owned OriaTheme editor source components.",
  "type": "module",
  "bin": {
    "oria": "./dist/index.js"
  },
  "files": ["dist", "registry", "LICENSE"],
  "publishConfig": { "access": "public" },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prepack": "node ../../scripts/prepare-package-license.mjs",
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean && node scripts/copy-registry.mjs",
    "lint": "eslint src test",
    "test": "pnpm build && vitest run",
    "typecheck": "tsc --noEmit"
  }
}
