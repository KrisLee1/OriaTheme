{
  "name": "oriatheme",
  "version": "0.0.0-private",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "dev:example:react": "pnpm --filter @oriatheme/example-react dev",
    "dev:example:vue": "pnpm --filter @oriatheme/example-vue dev",
    "dev:example:next": "pnpm --filter @oriatheme/example-next dev --port 5173"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@changesets/cli": "^2.29.0",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3",
    "tsup": "^8.5.0",
    "typescript-eslint": "^8.31.0",
    "vite": "^6.2.0",
    "vitest": "^3.1.3"
  }
}
